<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.EditFoodPage"
             Title="Edit Food">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#FDE8E8, Dark=#1A1A1A}" Offset="0.0" />
            <GradientStop Color="{AppThemeBinding Light=#F5F5F0, Dark=#1A1A1A}" Offset="0.5" />
            <GradientStop Color="{AppThemeBinding Light=#E8F0E8, Dark=#0F0F0F}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">
            <Border StrokeThickness="0" Padding="18" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Label Text="Edit Food Item"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#FFFFFF}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Grid.Row="1"
                           Text="Update the details of this food or drink"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#9A8A8A, Dark=#A0A0A0}" />
                </Grid>
            </Border>

            <!-- Basic Information Section -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Basic Information" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}" />
                    <Entry x:Name="NameEntry"
                           Placeholder="Name"
                           BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}"
                           TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}"
                           SemanticProperties.Hint="Required food or drink name" />
                    <Entry x:Name="CategoryEntry"
                           Placeholder="Category"
                           BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}"
                           TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}"
                           SemanticProperties.Hint="Category (e.g., Breakfast, Lunch, Dinner, Drink)" />
                    <Editor x:Name="DescriptionEditor"
                            Placeholder="Description, ingredients, flavour, or context"
                            AutoSize="TextChanges"
                            HeightRequest="104"
                            BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}"
                            TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}"
                            SemanticProperties.Hint="Describe this food or drink" />
                </VerticalStackLayout>
            </Border>

            <!-- Nutrition Data Section -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Label Text="Nutrition Data" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Secondary}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="CaloriesEntry"
                               Placeholder="Calories"
                               Keyboard="Numeric"
                               BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}"
                               TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}"
                               SemanticProperties.Hint="Required calories as a number" />
                        <Entry x:Name="ProteinEntry"
                               Grid.Column="1"
                               Placeholder="Protein (g)"
                               Keyboard="Numeric"
                               BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}"
                               TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="CarbsEntry"
                               Placeholder="Carbs (g)"
                               Keyboard="Numeric"
                               BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}"
                               TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}" />
                        <Entry x:Name="FatEntry"
                               Grid.Column="1"
                               Placeholder="Fat (g)"
                               Keyboard="Numeric"
                               BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}"
                               TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}" />
                    </Grid>
                    <Entry x:Name="AllergyEntry"
                           Placeholder="Allergy note or dietary restriction"
                           BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#3A3A3A}"
                           TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}"
                           SemanticProperties.Hint="Enter allergy or dietary information" />
                </VerticalStackLayout>
            </Border>

            <!-- Validation Panel -->
            <Border x:Name="ValidationPanel"
                    IsVisible="False"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FDE8E8, Dark=#3A2A2A}"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="ValidationLabel"
                       TextColor="{StaticResource Secondary}"
                       FontAttributes="Bold" />
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Save Changes"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="OnSaveClicked"
                        SemanticProperties.Hint="Save changes to this record" />
                <Button Grid.Column="1"
                        Text="Cancel"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Clicked="OnCancelClicked"
                        SemanticProperties.Hint="Cancel editing" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>