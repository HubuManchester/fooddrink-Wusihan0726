<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.SettingsPage"
             Title="Profile">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Border" x:Key="CardBorder">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,8" />
            </Style>

            <Style TargetType="Label" x:Key="SectionTitle">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#81C784, Dark=#81C784}" />
            </Style>

            <Style TargetType="Label" x:Key="RowLabel">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#5A4A4A, Dark=#C0C0C0}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#FDE8E8, Dark=#1A1A1A}" Offset="0.0" />
            <GradientStop Color="{AppThemeBinding Light=#F5F5F0, Dark=#1A1A1A}" Offset="0.5" />
            <GradientStop Color="{AppThemeBinding Light=#E8F0E8, Dark=#0F0F0F}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Header -->
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12" HorizontalOptions="Center" Margin="0,20,0,10">
                <Border Grid.Row="0"
                        WidthRequest="100"
                        HeightRequest="100"
                        StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E8B4B4" Offset="0.0" />
                            <GradientStop Color="#C8E6C9" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="50" />
                    </Border.StrokeShape>
                </Border>

                <Label x:Name="UserNameLabel"
                       Grid.Row="1"
                       Text="NutriBite User"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#E0E0E0}"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUserNameTapped" NumberOfTapsRequired="1" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Appearance Card -->
            <Border Style="{StaticResource CardBorder}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">
                    <Label Text="Appearance" Style="{StaticResource SectionTitle}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Theme"
                               Style="{StaticResource RowLabel}" />
                        <Picker x:Name="ThemePicker"
                                Title="Select theme"
                                WidthRequest="140"
                                SelectedIndexChanged="OnThemeChanged"
                                TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#C0C0C0}"
                                TitleColor="#81C784">
                            <Picker.Items>
                                <x:String>System default</x:String>
                                <x:String>Light mode</x:String>
                                <x:String>Dark mode</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0E0E0, Dark=#3A3A3A}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Large text"
                               Style="{StaticResource RowLabel}" />
                        <Switch x:Name="LargeTextSwitch"
                                Toggled="OnLargeTextToggled"
                                OnColor="#81C784"
                                ThumbColor="White" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0E0E0, Dark=#3A3A3A}" />

                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="LargeTextPreviewTitle"
                               Text="Font preview"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#E8B4B4" />
                        <Label x:Name="LargeTextPreviewBody"
                               Text="Enable large text above to preview the effect"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#9A8A8A, Dark=#A0A0A0}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- About Card -->
            <Border Style="{StaticResource CardBorder}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16">
                    <Label Text="About" Style="{StaticResource SectionTitle}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="Version"
                               Style="{StaticResource RowLabel}" />
                        <Label Grid.Column="1"
                               Text="1.0.0"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#B0A0A0, Dark=#808080}"
                               HorizontalOptions="End" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0E0E0, Dark=#3A3A3A}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="Data source"
                               Style="{StaticResource RowLabel}" />
                        <Label Grid.Column="1"
                               Text="Local + MockAPI"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#B0A0A0, Dark=#808080}"
                               HorizontalOptions="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Status Label -->
            <Label x:Name="SettingsStatusLabel"
                   Text="Settings ready"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#81C784"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>