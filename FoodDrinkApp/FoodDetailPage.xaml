<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Nutrition Details">

	<ContentPage.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="{AppThemeBinding Light=#FDE8E8, Dark=#1A1A1A}" Offset="0.0" />
			<GradientStop Color="{AppThemeBinding Light=#F5F5F0, Dark=#1A1A1A}" Offset="0.5" />
			<GradientStop Color="{AppThemeBinding Light=#E8F0E8, Dark=#0F0F0F}" Offset="1.0" />
		</LinearGradientBrush>
	</ContentPage.Background>

	<ScrollView>
		<VerticalStackLayout Padding="22" Spacing="16">
			<Border StrokeThickness="0" Padding="18">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="16" />
				</Border.StrokeShape>
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#81C784" Offset="0.0" />
						<GradientStop Color="#E8B4B4" Offset="0.72" />
						<GradientStop Color="#FDE8E8" Offset="1.0" />
					</LinearGradientBrush>
				</Border.Background>
				<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
					<Label x:Name="NameLabel"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           SemanticProperties.HeadingLevel="Level1" />
					<Label x:Name="CategoryLabel"
                           Grid.Row="1"
                           FontSize="15"
                           TextColor="#FFF5E8" />
					<Label x:Name="CaloriesLabel"
                           Grid.Row="2"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#FFF0C9" />
				</Grid>
			</Border>

			<Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                    Padding="16">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="16" />
				</Border.StrokeShape>
				<VerticalStackLayout Spacing="12">
					<Label Text="Nutrition Overview"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
					<Label x:Name="MacroLabel"
                           FontSize="16"
                           TextColor="{StaticResource Secondary}" />
					<BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0E0E0, Dark=#3A3A3A}" />
					<Label x:Name="DescriptionLabel"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#C0C0C0}" />
					<Label x:Name="AllergyLabel"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Secondary}" />
				</VerticalStackLayout>
			</Border>

			<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
				<Button Text="Read summary"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="#FFFFFF"
                        Clicked="OnSpeakClicked"
                        SemanticProperties.Hint="Read the nutrition summary aloud" />
				<Button Grid.Column="1"
                        Text="Stop reading"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                        BorderColor="{StaticResource Secondary}"
                        BorderWidth="1"
                        TextColor="{StaticResource Secondary}"
                        Clicked="OnStopSpeechClicked"
                        SemanticProperties.Hint="Stop the current speech" />
			</Grid>

			<Button Text="Vibration reminder"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="#FFFFFF"
                    Clicked="OnVibrateClicked"
                    SemanticProperties.Hint="Use mobile vibration as a meal reminder" />
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>