<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.JournalDetailPage"
             x:DataType="models:JournalEntry"
             Title="Journal Detail">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#FDE8E8, Dark=#1A1A1A}" Offset="0.0" />
            <GradientStop Color="{AppThemeBinding Light=#F5F5F0, Dark=#1A1A1A}" Offset="0.5" />
            <GradientStop Color="{AppThemeBinding Light=#E8F0E8, Dark=#0F0F0F}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">
            <!-- Photo Section -->
            <Border StrokeThickness="0" Padding="0" IsVisible="{Binding HasPhoto}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Image x:Name="PhotoImage"
                       Aspect="AspectFill"
                       HeightRequest="250" />
            </Border>

            <!-- Info Card -->
            <Border StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Meal Details"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label x:Name="DateLabel"
                               Grid.Column="1"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#9A8A8A, Dark=#A0A0A0}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0E0E0, Dark=#3A3A3A}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="Meal Type"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                        <Label x:Name="MealTypeLabel"
                               Grid.Column="1"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#C0C0C0}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                          IsVisible="{Binding LocationAddress}">
                        <Label Text="Location"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                        <Label x:Name="LocationLabel"
                               Grid.Column="1"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#C0C0C0}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                          IsVisible="{Binding HasPhoto}">
                        <Label Text="Coordinates"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" />
                        <Label x:Name="CoordinateLabel"
                               Grid.Column="1"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#9A8A8A, Dark=#A0A0A0}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F0E0E0, Dark=#3A3A3A}" />

                    <VerticalStackLayout>
                        <Label Text="Notes"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label x:Name="NotesLabel"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#C0C0C0}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read Aloud"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="#FFFFFF"
                        Clicked="OnReadAloudClicked"
                        SemanticProperties.Hint="Read this journal entry aloud" />
                <Button Text="Edit"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="#FFFFFF"
                        Clicked="OnEditClicked"
                        SemanticProperties.Hint="Edit this journal entry" />
                <Button Grid.Column="1"
                        Text="Delete"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="#FFFFFF"
                        Clicked="OnDeleteClicked"
                        SemanticProperties.Hint="Delete this journal entry" />
            </Grid>

            <Label x:Name="StatusLabel"
                   Text=""
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>