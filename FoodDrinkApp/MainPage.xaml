<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.MainPage"
             Title="Foods">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{AppThemeBinding Light=#FDE8E8, Dark=#1A1A1A}" Offset="0.0" />
            <GradientStop Color="{AppThemeBinding Light=#F5F5F0, Dark=#1A1A1A}" Offset="0.45" />
            <GradientStop Color="{AppThemeBinding Light=#E8F0E8, Dark=#0F0F0F}" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Grid Padding="20,18,20,12">
            <Border StrokeThickness="0" Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#81C784" Offset="0.0" />
                        <GradientStop Color="#E8B4B4" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Label Text="NutriBite"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Grid.Row="1"
                           Text="Track your meals"
                           FontSize="14"
                           TextColor="#FFFFFF"
                           Opacity="0.9" />
                </Grid>
            </Border>
        </Grid>

        <!-- Search Bar Row -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="16,0,16,12">
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                    Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <SearchBar x:Name="SearchFoodBar"
                           Placeholder="Search foods..."
                           TextChanged="OnSearchTextChanged"
                           SearchButtonPressed="OnSearchButtonPressed"
                           TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#B0A0A0, Dark=#808080}"
                           BackgroundColor="Transparent"
                           SemanticProperties.Hint="Search food by name, category, or tag" />
            </Border>
            <Button Grid.Column="1"
                    Text="+"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="#FFFFFF"
                    FontSize="24"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    Padding="0"
                    Clicked="OnAddClicked"
                    SemanticProperties.Hint="Add new food record" />
        </Grid>

        <!-- Food List -->
        <RefreshView Grid.Row="2" x:Name="FoodRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="FoodCollection"
                            SelectionMode="None"
                            EmptyView="No matching foods found"
                            Margin="16,0,16,18">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodItem">
                        <Border StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                Padding="0"
                                Margin="0,0,0,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="6,*">
                                <BoxView BackgroundColor="{StaticResource Primary}" />
                                <Grid Grid.Column="1" Padding="16" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,*,*" RowSpacing="6" ColumnSpacing="8">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#3A2518, Dark=#FFFFFF}"
                                           LineBreakMode="TailTruncation"
                                           SemanticProperties.HeadingLevel="Level2" />
                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light=#FDE8E8, Dark=#3A2A2A}"
                                            Padding="8,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding CaloriesLabel}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}" />
                                    </Border>
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="4"
                                           Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#8A7A6A, Dark=#B0B0B0}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                    <Label Grid.Row="2"
                                           Grid.ColumnSpan="4"
                                           Text="{Binding MacroSummary}"
                                           FontSize="12"
                                           TextColor="{StaticResource Primary}" />
                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Text="{Binding Category}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Secondary}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Row="3"
                                            Grid.Column="2"
                                            Text="Edit"
                                            Padding="12,6"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="#FFFFFF"
                                            FontSize="12"
                                            CornerRadius="8"
                                            CommandParameter="{Binding Id}"
                                            Clicked="OnEditClicked"
                                            SemanticProperties.Hint="Edit this food item" />
                                    <Button Grid.Row="3"
                                            Grid.Column="3"
                                            Text="Delete"
                                            Padding="12,6"
                                            BackgroundColor="{StaticResource Secondary}"
                                            TextColor="#FFFFFF"
                                            FontSize="12"
                                            CornerRadius="8"
                                            CommandParameter="{Binding Id}"
                                            Clicked="OnDeleteClicked"
                                            SemanticProperties.Hint="Delete this food item" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>