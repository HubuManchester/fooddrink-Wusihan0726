<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.JournalPage"
             Title="Journal">

	<ContentPage.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
			<GradientStop Color="{AppThemeBinding Light=#FDE8E8, Dark=#1A1A1A}" Offset="0.0" />
			<GradientStop Color="{AppThemeBinding Light=#F5F5F0, Dark=#1A1A1A}" Offset="0.5" />
			<GradientStop Color="{AppThemeBinding Light=#E8F0E8, Dark=#0F0F0F}" Offset="1.0" />
		</LinearGradientBrush>
	</ContentPage.Background>

	<Grid RowDefinitions="Auto,*">
		<Grid Padding="20,18,20,12">
			<Border StrokeThickness="0" Padding="16" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="16" />
				</Border.StrokeShape>
				<Grid RowDefinitions="Auto,Auto" RowSpacing="6">
					<Label Text="Meal Journal"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#FFFFFF}"
                           SemanticProperties.HeadingLevel="Level1" />
					<Label Grid.Row="1"
                           Text="Capture your meals with photos, locations, and notes."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#9A8A8A, Dark=#A0A0A0}" />
				</Grid>
			</Border>
		</Grid>

		<RefreshView Grid.Row="1" x:Name="JournalRefreshView" Refreshing="OnRefreshing">
			<CollectionView x:Name="JournalCollection"
                            SelectionMode="None"
                            EmptyView="No journal entries yet. Tap + to write your first meal diary."
                            Margin="16,0,16,18">
				<CollectionView.ItemsLayout>
					<LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:JournalEntry">
						<Border StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                Padding="0">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="16" />
							</Border.StrokeShape>
							<Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*" RowSpacing="8" ColumnSpacing="8">
								<!-- Header -->
								<Label Grid.Row="0" Grid.ColumnSpan="4"
                                       Text="{Binding DisplayTitle}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />

								<!-- Location -->
								<Label Grid.Row="1" Grid.ColumnSpan="4"
                                       Text="{Binding LocationAddress, StringFormat='Location: {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Secondary}"
                                       IsVisible="{Binding LocationAddress}"
                                       LineBreakMode="TailTruncation" />

								<!-- Notes Preview -->
								<Label Grid.Row="2" Grid.ColumnSpan="4"
                                       Text="{Binding Notes}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#5A4A4A, Dark=#C0C0C0}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

								<!-- Action Buttons -->
								<Button Grid.Row="3" Grid.Column="1"
                                        Text="View"
                                        Padding="12,6"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="#FFFFFF"
                                        FontSize="12"
                                        CornerRadius="8"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnViewClicked"
                                        SemanticProperties.Hint="View journal entry details" />

								<Button Grid.Row="3" Grid.Column="2"
                                        Text="Edit"
                                        Padding="12,6"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="#FFFFFF"
                                        FontSize="12"
                                        CornerRadius="8"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnEditClicked"
                                        SemanticProperties.Hint="Edit this journal entry" />

								<Button Grid.Row="3" Grid.Column="3"
                                        Text="Delete"
                                        Padding="12,6"
                                        BackgroundColor="{StaticResource Secondary}"
                                        TextColor="#FFFFFF"
                                        FontSize="12"
                                        CornerRadius="8"
                                        CommandParameter="{Binding Id}"
                                        Clicked="OnDeleteClicked"
                                        SemanticProperties.Hint="Delete this journal entry" />
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>
		</RefreshView>

		<!-- Floating Action Button -->
		<Grid Grid.Row="1" VerticalOptions="End" HorizontalOptions="End" Margin="0,0,20,20">
			<Border WidthRequest="56"
                    HeightRequest="56"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#81C784" Offset="0.0" />
						<GradientStop Color="#E8B4B4" Offset="1.0" />
					</LinearGradientBrush>
				</Border.Background>
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="28" />
				</Border.StrokeShape>
				<Button Text="+"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        BackgroundColor="Transparent"
                        Padding="0"
                        Clicked="OnAddClicked"
                        SemanticProperties.Hint="Add a new journal entry" />
			</Border>
		</Grid>
	</Grid>
</ContentPage>